# ------------------------------------------------------------------
# Copie para .env.local (desenvolvimento) ou cadastre na Vercel
# (Settings > Environment Variables). Nunca comite o .env.local.
# ------------------------------------------------------------------

# --- Banco de dados (Neon) -----------------------------------------
# Use a connection string COM POOLER (o host tem "-pooler" no nome).
# Sem esta variável o site sobe em modo demonstração: navega normal,
# mas nada que você salvar no painel fica gravado.
DATABASE_URL=postgresql://usuario:senha@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# --- Sessão do painel ----------------------------------------------
# Mínimo de 32 caracteres. Gere com: openssl rand -base64 32
AUTH_SECRET=

# --- Administrador -------------------------------------------------
# Gere o hash com: npm run admin:criar
# Se você já criou o admin na tabela admin_users, estas três não são
# necessárias. Jamais coloque a senha em texto puro aqui.
#
# ATENÇÃO ao hash: ele é cheio de cifrões ($2b$12$...) e NESTE ARQUIVO
# cada cifrão precisa vir escapado com barra invertida (\$). O leitor de
# .env do Next expande $VAR, então "$2b" viraria variável e o valor
# chegaria VAZIO no servidor — o login recusaria até a senha correta.
# Aspas (simples ou duplas) não resolvem: só a barra invertida.
# No painel da Vercel é o contrário: cole o hash cru, sem barras.
# O comando `npm run admin:criar` já imprime as duas versões prontas.
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_SENHA_HASH=\$2b\$12\$coloque.aqui.o.hash.gerado.pelo.comando.admin.criar

# --- Fotos dos produtos (Cloudinary) -------------------------------
# Sem estas variáveis o upload de foto fica desligado e os produtos
# aparecem com a arte de fallback do próprio site.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_PASTA=frigorifico/produtos

# --- E-mail (canal ATIVO do MVP) -----------------------------------
# Crie a chave em resend.com e verifique o domínio do remetente.
RESEND_API_KEY=
EMAIL_REMETENTE="Frigorífico Mata Bem <ofertas@seudominio.com.br>"

# URL pública do site — entra nos links dos e-mails e no descadastro.
# Na Vercel é detectada sozinha; defina se usar domínio próprio.
NEXT_PUBLIC_SITE_URL=

# --- Chaves de canal (feature flags) -------------------------------
# E-mail: ligado por padrão.
CANAL_EMAIL_ATIVO=true

# WhatsApp via Evolution API — DESLIGADO de propósito.
# API não oficial (roda sobre o WhatsApp Web): disparo de ofertas em
# massa tem risco real de banimento do número da loja. Só ligue com
# número secundário, volume baixo e risco assumido pelo cliente.
CANAL_EVOLUTION_ATIVO=false
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=

# WhatsApp Cloud API (oficial Meta) — DESLIGADO até decisão comercial.
# Sem risco de banimento e com template aprovado, porém exige conta
# Meta Business verificada e tem custo por conversa.
CANAL_WHATSAPP_CLOUD_ATIVO=false
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=
WHATSAPP_CLOUD_VERSAO=v21.0
